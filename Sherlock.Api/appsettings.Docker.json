{
  "_comment": "Segredos vazios de proposito: o docker-compose injeta ConnectionStrings__* e JwtSettings__SecretKey a partir do .env.",
  "ConnectionStrings": {
    "DefaultConnection": "",
    "SherlockDb": "",
    "Redis": "redis:6379"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "UseRedis": true,
  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "Sherlock",
    "Audience": "All",
    "ExpiryInMinutes": 120
  },
  "QueryCache": {
    "DefaultCacheTimeMinutes": 30
  }
}
