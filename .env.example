# Modelo de variaveis de ambiente. Copie para .env e preencha com valores reais:
#   cp .env.example .env
# Gere segredos fortes com:
#   openssl rand -base64 24   (senhas)   /   openssl rand -base64 48   (jwt)

# --- Superusuario do Postgres (admin, para administracao manual) ---
POSTGRES_USER=sherlock_admin
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=sherlock_db

# --- Usuario da aplicacao (privilegios limitados, usado pela API) ---
APP_DB_USER=sherlock_app
APP_DB_PASSWORD=troque-por-outra-senha-forte

# --- Autenticacao JWT ---
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# --- Envio de e-mail (SMTP) ---
# Enabled=false (padrao): nada sai da maquina, as mensagens vao para o log da API.
# Para ver o e-mail montado em desenvolvimento, suba o Mailpit e use:
#   Email__Enabled=true  Email__Host=localhost  Email__Port=1025  Email__UseStartTls=false
# Em producao, apontar para o relay do provedor (porta 587, STARTTLS, usuario e senha).
EMAIL_ENABLED=false
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_STARTTLS=true
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_ADDRESS=nao-responda@ratodelivraria.com.br
EMAIL_FROM_NAME=ratodelivraria

# --- Vigia de preco ---
# Os dois workers nascem desligados. Sweep manda requisicao para as livrarias de
# madrugada; Notify manda o resumo diario por e-mail (e depende de EMAIL_ENABLED).
WATCH_SWEEP_ENABLED=false
WATCH_NOTIFY_ENABLED=false

# --- Entrar com Google ---
# Client ID do tipo "Web application", criado no Google Cloud Console.
# Vazio desliga o botao. E publico por desenho (vai no HTML) e neste fluxo
# NAO existe client secret: o ID token e verificado por assinatura.
# Origens JavaScript autorizadas: http://localhost:4200 e o dominio de producao.
GOOGLE_CLIENT_ID=
